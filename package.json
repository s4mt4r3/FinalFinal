{
  "name": "finalfinal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "test:db": "vitest run --project db",
    "test:e2e": "playwright test",
    "build:test": "NODE_ENV=test next build",
    "start:test": "NODE_ENV=test next start -p 3100",
    "db:test:start": "supabase start -x vector,logflare,studio,imgproxy,edge-runtime,realtime,postgres-meta,supavisor",
    "db:test:stop": "supabase stop",
    "verify": "npm run typecheck && npm run lint && npm run test:coverage && npm run test:db && npm run build:test && E2E_PREBUILT=1 npm run test:e2e",
    "prepare": "husky",
    "types:generate": "supabase gen types typescript --linked > types/database.generated.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.106.0",
    "@types/pdf-parse": "^1.1.5",
    "html2pdf.js": "^0.14.0",
    "lucide-react": "^1.16.0",
    "mammoth": "^1.12.0",
    "next": "^15.0.0",
    "pdf-parse": "^2.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "~6.6",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.18",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "msw": "^2.15.0",
    "pg": "^8.23.1",
    "supabase": "^1.200.0",
    "typescript": "^5.6.0",
    "vite": "^6.4.4",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "postcss": "^8.5.15",
    "tar": "^7.5.15"
  }
}
